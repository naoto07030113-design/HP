{
  "name": "bakery-walk-video",
  "version": "1.0.0",
  "private": true,
  "description": "Papercraft 2.5D animation (Remotion) - BakeryWalk",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "audio": "node scripts/generate-audio.mjs && node scripts/generate-audio-mansion.mjs",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts BakeryWalk",
    "render": "remotion render src/index.ts BakeryWalk out/bakery-walk.mp4 --crf=20",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs",
    "render:mansion": "remotion render src/index.ts MansionPatrol out/mansion-patrol.mp4 --crf=20"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3"
  }
}
